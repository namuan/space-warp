<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox - Disabled for accessibility requirements -->
    <!-- Note: Window management apps cannot be sandboxed due to 
         Accessibility API requirements. Distribution will be via 
         direct download or Setapp, not Mac App Store. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    
    <!-- Apple Events (Automation) -->
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.apple.systemevents</string>
        <string>com.apple.finder</string>
    </array>
    
    <!-- Files (for database access) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Network (optional, for future update checking) -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Hardened Runtime -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- Required for private frameworks (SkyLight) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Disable firmware validation (required for CGDisplay APIs) -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
</dict>
</plist>
